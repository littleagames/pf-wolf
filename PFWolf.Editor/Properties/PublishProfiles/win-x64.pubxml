<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained Windows x64 deploy: bundles the .NET runtime so mappers don't need it installed.
     dotnet publish PFWolf.Editor -p:PublishProfile=win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Avalonia's native libraries (Skia, HarfBuzz, ANGLE) go inside the exe too, unpacked on first run -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Avalonia's XAML and the view models are reached by reflection; trimming breaks them -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- SkiaSharp and HarfBuzzSharp ship ~100 MB of native debug symbols; keep them out of the deploy -->
  <Target Name="DropNativePdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' And $([System.String]::Copy('%(Filename)').StartsWith('lib'))" />
    </ItemGroup>
  </Target>
</Project>
