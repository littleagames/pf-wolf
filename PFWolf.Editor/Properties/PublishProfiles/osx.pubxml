<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained macOS deploy: bundles the .NET runtime, so mappers need nothing installed.
     Apple Silicon unless -r says otherwise:
     dotnet publish PFWolf.Editor -p:PublishProfile=osx [-r osx-x64]
     packaging/macos/make-apps.sh does this for the game and the editor and makes the .apps. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>bin\publish\$(RuntimeIdentifier)\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Avalonia's native libraries (Skia, HarfBuzz, AvaloniaNative) and OpenAL Soft go inside the exe too, unpacked on first run -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Avalonia's XAML and the view models are reached by reflection; trimming breaks them -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- SkiaSharp and HarfBuzzSharp ship ~100 MB of native debug symbols; keep them out of the deploy -->
  <Target Name="DropNativePdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' And $([System.String]::Copy('%(Filename)').StartsWith('lib'))" />
    </ItemGroup>
  </Target>
</Project>
