<Project Sdk="Microsoft.NET.Sdk">

  <!-- The PFWolf map editor: reads the game's assets through PFWolf.Common, as the engine does -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PFWolf.Editor</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The 3D view calls OpenGL through function pointers -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<FileVersion>0.4.0.0</FileVersion>
	<AssemblyVersion>0.4.0.0</AssemblyVersion>
    <Version>0.4.0</Version>
    <Authors>Andrew McCauley</Authors>
    <Company>Little A Games</Company>
    <Copyright>Copyright (c) 2026 Little A Games</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PFWolf.Common\PFWolf.Common.csproj" />
  </ItemGroup>

  <!-- What New mod's stand-alone game starts with (Editing/NewMod.cs): the example game's art,
       sounds, definitions and level. NewMod writes its own gamepack-info, modinfo and game-info. -->
  <ItemGroup>
    <EmbeddedResource Include="..\examples\mods\standalone-demo\**\*"
                      Exclude="..\examples\mods\standalone-demo\*.zip;..\examples\mods\standalone-demo\gamepack-info.yaml;..\examples\mods\standalone-demo\modinfo.yaml;..\examples\mods\standalone-demo\game-info.yaml"
                      LogicalName="StandaloneStarter/%(RecursiveDir)%(Filename)%(Extension)"
                      Visible="false" />
  </ItemGroup>

</Project>
