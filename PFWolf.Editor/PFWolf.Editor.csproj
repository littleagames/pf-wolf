<Project Sdk="Microsoft.NET.Sdk">

  <!-- The PFWolf map editor: reads the game's assets through PFWolf.Common, as the engine does -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PFWolf.Editor</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The 3D view calls OpenGL through function pointers -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<FileVersion>0.6.0.0</FileVersion>
	<AssemblyVersion>0.6.0.0</AssemblyVersion>
    <Version>0.6.0</Version>
    <Authors>Andrew McCauley</Authors>
    <Company>Little A Games</Company>
    <Copyright>Copyright (c) 2026 Little A Games</Copyright>
    <ApplicationIcon>..\icons\pfwolf-editor.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The splash screen's authors and website (EditorInfo); the version and copyright are already attributes -->
  <ItemGroup>
    <AssemblyMetadata Include="Authors" Value="$(Authors)" />
    <AssemblyMetadata Include="Website" Value="https://www.littleagames.com" />
  </ItemGroup>

  <!-- The window icon (App.axaml) and the splash screen's logo; the source art is icons/pfwolf-editor.svg -->
  <ItemGroup>
    <AvaloniaResource Include="..\icons\pfwolf-editor.ico" Link="Assets\pfwolf-editor.ico" />
    <AvaloniaResource Include="..\icons\pfwolf-editor-256.png" Link="Assets\pfwolf-editor-256.png" />
  </ItemGroup>

  <!-- The splash screen's credits (EditorInfo): one line each, edited freely -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\credits.txt" LogicalName="credits.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LuaCSharp" Version="0.5.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PFWolf.Common\PFWolf.Common.csproj" />
  </ItemGroup>

  <!-- What New mod's stand-alone game starts with (Editing/NewMod.cs): the example game's art,
       sounds, definitions and level. NewMod writes its own gamepack-info, modinfo and game-info. -->
  <!-- The script browser's Lua highlighting (Rendering/LuaHighlighting) -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Lua.xshd" LogicalName="Lua.xshd" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\examples\mods\standalone-demo\**\*" Exclude="..\examples\mods\standalone-demo\*.zip;..\examples\mods\standalone-demo\gamepack-info.yaml;..\examples\mods\standalone-demo\modinfo.yaml;..\examples\mods\standalone-demo\game-info.yaml" LogicalName="StandaloneStarter/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

</Project>
