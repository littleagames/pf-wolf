<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PFWolf.Editor.ViewModels"
        xmlns:r="using:PFWolf.Editor.Rendering"
        xmlns:v="using:PFWolf.Editor.Views"
        x:Class="PFWolf.Editor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1400" Height="860" MinWidth="900" MinHeight="560">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewMapCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding ImportMapCommand}" />
    <KeyBinding Gesture="Ctrl+H" Command="{Binding ReplaceCommand}" />
    <KeyBinding Gesture="F4" Command="{Binding EditPropertiesCommand}" />
    <KeyBinding Gesture="F7" Command="{Binding CheckLevelCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding PlayCommand}" />
    <KeyBinding Gesture="Shift+F5" Command="{Binding PlayHereCommand}" />
    <KeyBinding Gesture="F3" Command="{Binding Toggle3DCommand}" />
    <KeyBinding Gesture="F6" Command="{Binding ShowArtCommand}" />
    <KeyBinding Gesture="F8" Command="{Binding ShowSoundsCommand}" />
    <KeyBinding Gesture="F9" Command="{Binding ShowPalettesCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding ShowTextsCommand}" />
    <KeyBinding Gesture="F11" Command="{Binding ShowDefinitionsCommand}" />
    <KeyBinding Gesture="F12" Command="{Binding ShowScriptsCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <!-- The toolbar's and options bar's icon buttons -->
    <Style Selector="Button.icon, ToggleButton.icon">
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="PathIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Separator.bar">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Every command, with its key -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Load the game" Command="{Binding LoadCommand}"
                  ToolTip.Tip="Loads the game in the game folder with the mods, again if it's loaded (to see what's changed in the mods)" />
        <Separator />
        <MenuItem Header="_New level…" Command="{Binding NewMapCommand}" InputGesture="Ctrl+N" />
        <MenuItem Header="_Import map…" Command="{Binding ImportMapCommand}" InputGesture="Ctrl+I"
                  ToolTip.Tip="Planes from a WDC .map (or an ECWolf .wad) onto this level, or as a new level; pick which planes" />
        <Separator />
        <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S"
                  ToolTip.Tip="To maps/NAME.wad in the level's mod (a folder or a pk3)" />
        <MenuItem Header="Save _to…" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S"
                  ToolTip.Tip="To another mod (a folder or a pk3)" />
        <Separator />
        <MenuItem Header="New _mod…" Command="{Binding NewModCommand}"
                  ToolTip.Tip="A new pk3: a stand-alone game (needing no other game's files) or a mod of one of PFWolf's games" />
        <MenuItem Header="Add mod _pk3…" Click="AddModFile" />
        <MenuItem Header="Add mod _folder…" Click="AddModFolder" />
        <Separator />
        <MenuItem Header="E_xit" Click="ExitEditor" InputGesture="Alt+F4" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
        <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
        <Separator />
        <MenuItem Header="Cu_t" Command="{Binding CutCommand}" InputGesture="Ctrl+X" />
        <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C" />
        <MenuItem Header="_Paste" Command="{Binding PasteCommand}" InputGesture="Ctrl+V"
                  ToolTip.Tip="The copied tiles follow the pointer until a click puts them down" />
        <MenuItem Header="Dup_licate" Command="{Binding DuplicateCommand}" InputGesture="Ctrl+D"
                  ToolTip.Tip="Copies the selection and picks the copy up, to click down somewhere else" />
        <MenuItem Header="_Delete" Command="{Binding DeleteSelectionCommand}" InputGesture="Delete"
                  ToolTip.Tip="Clears the selection: open floor on plane 0, nothing on the others" />
        <MenuItem Header="Paste o_ver (skip empty tiles)" ToggleType="CheckBox" IsChecked="{Binding PasteSkipsBlank}"
                  ToolTip.Tip="A paste leaves what's under its open floor (on plane 0) and its empty tiles (on the other planes)" />
        <Separator />
        <MenuItem Header="R_eplace…" Command="{Binding ReplaceCommand}" InputGesture="Ctrl+H"
                  ToolTip.Tip="One value for another on the plane being edited, in the selection or the whole level" />
        <Separator />
        <MenuItem Header="Rotate c_lockwise" Command="{Binding RotateClockwiseCommand}" InputGesture="OemCloseBrackets"
                  ToolTip.Tip="The selection turns around its middle (or the paste being placed turns); things on it turn to face the new way">
          <MenuItem.Icon><PathIcon Data="{x:Static v:EditorIcons.RotateClockwise}" Width="16" Height="16" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Rotate counter-clock_wise" Command="{Binding RotateCounterClockwiseCommand}" InputGesture="OemOpenBrackets">
          <MenuItem.Icon><PathIcon Data="{x:Static v:EditorIcons.RotateCounterClockwise}" Width="16" Height="16" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Rotate 1_80°" Command="{Binding Rotate180Command}" />
        <MenuItem Header="Flip _horizontally" Command="{Binding FlipHorizontalCommand}" InputGesture="Shift+H">
          <MenuItem.Icon><PathIcon Data="{x:Static v:EditorIcons.FlipHorizontal}" Width="16" Height="16" /></MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Flip _vertically" Command="{Binding FlipVerticalCommand}" InputGesture="Shift+V">
          <MenuItem.Icon><PathIcon Data="{x:Static v:EditorIcons.FlipVertical}" Width="16" Height="16" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem Header="Select _all" Command="{Binding SelectAllCommand}" InputGesture="Ctrl+A" />
        <MenuItem Header="Select _nothing" Command="{Binding SelectNoneCommand}" InputGesture="Escape" />
        <MenuItem Header="_Invert selection" Command="{Binding InvertSelectionCommand}"
                  ToolTip.Tip="Selects every tile that isn't selected, and none that is" />
        <Separator />
        <MenuItem Header="C_opy all planes" ToggleType="CheckBox" IsChecked="{Binding CopyAllPlanes}"
                  ToolTip.Tip="Copy, cut, move and delete take every plane, not just the one being edited" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Walls" ToggleType="CheckBox" IsChecked="{Binding ShowWalls}" />
        <MenuItem Header="T_hings" ToggleType="CheckBox" IsChecked="{Binding ShowThings}" />
        <MenuItem Header="_Flats" ToggleType="CheckBox" IsChecked="{Binding ShowFlats}" />
        <MenuItem Header="H_eights" ToggleType="CheckBox" IsChecked="{Binding ShowHeights}" />
        <MenuItem Header="_Tags" ToggleType="CheckBox" IsChecked="{Binding ShowTags}" />
        <MenuItem Header="_Light zones" ToggleType="CheckBox" IsChecked="{Binding ShowZones}" />
        <MenuItem Header="_Grid" ToggleType="CheckBox" IsChecked="{Binding ShowGrid}" />
        <Separator />
        <MenuItem Header="_3D view" ToggleType="CheckBox" IsChecked="{Binding Show3D}" InputGesture="F3"
                  ToolTip.Tip="The level in 3D beside the map" />
        <MenuItem Header="3D: thi_ngs" ToggleType="CheckBox" IsChecked="{Binding Show3DThings}" IsEnabled="{Binding Show3D}" />
        <MenuItem Header="3D: _ceilings" ToggleType="CheckBox" IsChecked="{Binding Show3DCeilings}" IsEnabled="{Binding Show3D}" />
        <MenuItem Header="3D: _shading" ToggleType="CheckBox" IsChecked="{Binding Show3DShading}" IsEnabled="{Binding Show3D}"
                  ToolTip.Tip="The level's light, light zones and distance fade, as the game shows them" />
        <MenuItem Header="3D: _markers" ToggleType="CheckBox" IsChecked="{Binding Show3DMarkers}" IsEnabled="{Binding Show3D}"
                  ToolTip.Tip="Push walls in purple, switches in green; hovering a tagged tile shows everything with its tag in orange" />
        <Separator />
        <MenuItem Header="Fit the _level" Command="{Binding FitViewCommand}" InputGesture="Home" />
      </MenuItem>
      <MenuItem Header="_Tools" ItemsSource="{Binding Tools}">
        <MenuItem.Styles>
          <Style Selector="MenuItem > MenuItem" x:DataType="vm:ToolOption">
            <Setter Property="Header" Value="{Binding Label}" />
            <Setter Property="Icon">
              <Template>
                <PathIcon Data="{Binding Icon}" Width="16" Height="16" />
              </Template>
            </Setter>
            <Setter Property="InputGesture" Value="{Binding Gesture}" />
            <Setter Property="Command" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PickToolCommand}" />
            <Setter Property="CommandParameter" Value="{Binding Key}" />
            <Setter Property="ToolTip.Tip" Value="{Binding Description}" />
          </Style>
        </MenuItem.Styles>
      </MenuItem>
      <MenuItem Header="_Level">
        <MenuItem Header="Level _properties…" Command="{Binding EditPropertiesCommand}" InputGesture="F4"
                  ToolTip.Tip="Name, music, next level, colors, height, sky, flats, shading and light zones" />
        <MenuItem Header="_Check level" Command="{Binding CheckLevelCommand}" InputGesture="F7"
                  ToolTip.Tip="Player starts, unknown values, doors, switches and tags, zones, the level's edge, rooms the player can't reach" />
      </MenuItem>
      <MenuItem Header="_Resources">
        <MenuItem Header="_Textures and sprites…" Command="{Binding ShowArtCommand}" InputGesture="F6"
                  ToolTip.Tip="Every wall texture, flat, sprite and picture, where it comes from and what uses it" />
        <MenuItem Header="_Sounds and music…" Command="{Binding ShowSoundsCommand}" InputGesture="F8"
                  ToolTip.Tip="Every sound and song, to listen to, with where it comes from and what plays it" />
        <MenuItem Header="_Palettes…" Command="{Binding ShowPalettesCommand}" InputGesture="F9"
                  ToolTip.Tip="Every palette, to look at and edit, with where it comes from and what's drawn in it" />
        <MenuItem Header="Te_xts…" Command="{Binding ShowTextsCommand}" InputGesture="F2"
                  ToolTip.Tip="The help screens, end texts and briefings, each article page as the game shows it, with what's wrong with it" />
        <MenuItem Header="S_cripts…" Command="{Binding ShowScriptsCommand}" InputGesture="F12"
                  ToolTip.Tip="The Lua scripts the game runs (scripts/*.lua), with the actions they give, what calls them and what's wrong with them" />
        <Separator />
        <MenuItem Header="_Definitions…" Command="{Binding ShowDefinitionsCommand}" InputGesture="F11"
                  ToolTip.Tip="Game info, game packs, actor classes and map definitions, in fields or as YAML, saved into a mod (pfwolf.pk3 is read-only)" />
      </MenuItem>
      <MenuItem Header="_Play">
        <MenuItem Header="_Play" Command="{Binding PlayCommand}" InputGesture="F5"
                  ToolTip.Tip="Saves the level if it's changed, then starts PFWolf on it with the mods" />
        <MenuItem Header="Play from _here" Command="{Binding PlayHereCommand}" InputGesture="Shift+F5"
                  ToolTip.Tip="Over the map: start on the tile under the pointer (from the menu: the selected tile)" />
      </MenuItem>
    </Menu>

    <!-- The game: its folder, which game, and loading it -->
    <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="Game folder" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding GameFolder}" PlaceholderText="The folder PFWolf.exe and pfwolf.pk3 are in" />
        <Button Grid.Column="2" Content="Browse…" Click="BrowseGameFolder" />
        <ComboBox Grid.Column="3" ItemsSource="{Binding GameChoices}" SelectedItem="{Binding SelectedGame}" MinWidth="200" />
        <Button Grid.Column="4" Content="Load" Command="{Binding LoadCommand}" Classes="accent" />
      </Grid>
    </Border>

    <!-- Undo, saving, the 3D view and playing; then the options of the tool picked (wraps in a narrow window) -->
    <Border DockPanel.Dock="Top" Padding="8,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <WrapPanel ItemSpacing="6" LineSpacing="4">
        <Button Classes="icon" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)">
          <PathIcon Data="{x:Static v:EditorIcons.Undo}" />
        </Button>
        <Button Classes="icon" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y)">
          <PathIcon Data="{x:Static v:EditorIcons.Redo}" />
        </Button>
        <Separator Classes="bar" />
        <Button Classes="icon" Command="{Binding SaveCommand}" ToolTip.Tip="Save (Ctrl+S): to maps/NAME.wad in the level's mod (a folder or a pk3)">
          <PathIcon Data="{x:Static v:EditorIcons.Save}" />
        </Button>
        <Separator Classes="bar" />
        <ToggleButton Classes="icon" IsChecked="{Binding Show3D}" ToolTip.Tip="3D view (F3): the level in 3D beside the map">
          <PathIcon Data="{x:Static v:EditorIcons.View3D}" />
        </ToggleButton>
        <Separator Classes="bar" />
        <Button Command="{Binding PlayCommand}" Classes="accent"
                ToolTip.Tip="Play (F5): saves the level if it's changed, then starts PFWolf on it with the mods">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{x:Static v:EditorIcons.Play}" Width="14" Height="14" />
            <TextBlock Text="Play" />
          </StackPanel>
        </Button>
        <Button Content="From here" Command="{Binding PlayHereCommand}"
                ToolTip.Tip="Play from here (Shift+F5 over the map): start on the tile under the pointer (the button: the selected tile)" />
        <ComboBox ItemsSource="{Binding PlaySkills}" SelectedItem="{Binding SelectedPlaySkill}" MinWidth="150"
                  ToolTip.Tip="The skill Play starts on" VerticalAlignment="Center" />
        <Separator Classes="bar" />

        <!-- The tool's options -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <PathIcon Data="{Binding SelectedTool.Icon}" Opacity="0.7" />
          <TextBlock Text="{Binding SelectedTool.Label}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
          <CheckBox Content="Outline only" IsChecked="{Binding Outline}" IsVisible="{Binding ShowsOutlineOption}"
                    ToolTip.Tip="The box or ellipse is only its edge" VerticalAlignment="Center" />
          <CheckBox Content="Joined only" IsChecked="{Binding WandJoined}" IsVisible="{Binding ShowsWandOption}" VerticalAlignment="Center"
                    ToolTip.Tip="The wand takes the tiles joined to the one clicked; off, every tile on the level that holds the same" />

          <!-- The brushes -->
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowsBrushOptions}">
            <TextBlock Text="Size" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding BrushSize}" Minimum="1" Maximum="9" Increment="1" FormatString="0" Width="110"
                           ToolTip.Tip="How many tiles across the brush is" VerticalAlignment="Center" />
            <CheckBox Content="Round" IsChecked="{Binding BrushRound}" VerticalAlignment="Center"
                      ToolTip.Tip="A round brush instead of a square one (a plus at size 3)" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowsScatterOptions}">
            <TextBlock Text="Density %" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding ScatterDensity}" Minimum="1" Maximum="100" Increment="5" FormatString="0" Width="120"
                           ToolTip.Tip="How many of the tiles the brush passes over get something" VerticalAlignment="Center" />
            <Button Content="Add picked" Command="{Binding AddToScatterSetCommand}"
                    ToolTip.Tip="Adds what's picked in the palette to the values the scatter brush picks from at random" />
            <Button Content="Clear" Command="{Binding ClearScatterSetCommand}" />
            <TextBlock Text="{Binding ScatterSetInfo}" VerticalAlignment="Center" Opacity="0.7" MaxWidth="320"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ScatterSetInfo}" />
          </StackPanel>
          <TextBlock Text="{Binding StampInfo}" IsVisible="{Binding ShowsStampOptions}" VerticalAlignment="Center" Opacity="0.7" />

          <CheckBox Content="Copy all planes" IsChecked="{Binding CopyAllPlanes}" VerticalAlignment="Center" IsVisible="{Binding ShowsSelectionOptions}"
                    ToolTip.Tip="Copy, cut, move and delete take every plane, not just the one being edited" />
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowsTurnOptions}">
            <CheckBox Content="Paste over" IsChecked="{Binding PasteSkipsBlank}" VerticalAlignment="Center"
                      ToolTip.Tip="A paste or stamp leaves what's under its open floor (on plane 0) and its empty tiles (on the other planes)" />
            <Button Classes="icon" Command="{Binding RotateCounterClockwiseCommand}"
                    ToolTip.Tip="Rotate counter-clockwise ([): things on it turn to face the new way">
              <PathIcon Data="{x:Static v:EditorIcons.RotateCounterClockwise}" />
            </Button>
            <Button Classes="icon" Command="{Binding RotateClockwiseCommand}"
                    ToolTip.Tip="Rotate clockwise (]): things on it turn to face the new way">
              <PathIcon Data="{x:Static v:EditorIcons.RotateClockwise}" />
            </Button>
            <Button Classes="icon" Command="{Binding FlipHorizontalCommand}" ToolTip.Tip="Flip horizontally (Shift+H)">
              <PathIcon Data="{x:Static v:EditorIcons.FlipHorizontal}" />
            </Button>
            <Button Classes="icon" Command="{Binding FlipVerticalCommand}" ToolTip.Tip="Flip vertically (Shift+V)">
              <PathIcon Data="{x:Static v:EditorIcons.FlipVertical}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- What's under the pointer, and how things went, with what the tool's mouse buttons do -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding HoverInfo}" TextTrimming="CharacterEllipsis" MinHeight="18" />
        <Grid ColumnDefinitions="3*,2*" ColumnSpacing="16">
          <TextBlock Text="{Binding Status}" Opacity="0.7" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
          <TextBlock Grid.Column="1" Text="{Binding ToolHint}" Opacity="0.55" TextTrimming="CharacterEllipsis"
                     TextAlignment="Right" ToolTip.Tip="{Binding ToolHint}" />
        </Grid>
      </StackPanel>
    </Border>

    <Expander DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" Padding="0">
      <Expander.Header>
        <TextBlock>
          <Run Text="Problems loading: " /><Run Text="{Binding Problems.Count}" />
        </TextBlock>
      </Expander.Header>
      <ListBox ItemsSource="{Binding Problems}" Height="140" />
    </Expander>

    <Expander DockPanel.Dock="Bottom" HorizontalAlignment="Stretch" Padding="0" IsExpanded="{Binding ChecksExpanded}">
      <Expander.Header>
        <TextBlock>
          <Run Text="Level checks: " /><Run Text="{Binding Checks.Count}" /><Run Text="  (pick one to go to its tile)" Foreground="Gray" />
        </TextBlock>
      </Expander.Header>
      <ListBox ItemsSource="{Binding Checks}" SelectedItem="{Binding SelectedCheck}" Height="160" />
    </Expander>

    <!-- Levels and mods -->
    <Grid DockPanel.Dock="Left" Width="250" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="8">
      <TextBlock Grid.Row="0" Text="Levels" FontWeight="SemiBold" Margin="0,0,0,4" />
      <ListBox Grid.Row="1" ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="▶ Play" Command="{Binding PlayCommand}" InputGesture="F5" />
            <MenuItem Header="Level properties…" Command="{Binding EditPropertiesCommand}" InputGesture="F4" />
            <MenuItem Header="Check level" Command="{Binding CheckLevelCommand}" InputGesture="F7" />
            <Separator />
            <MenuItem Header="Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
            <MenuItem Header="Save to…" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
            <Separator />
            <MenuItem Header="New level…" Command="{Binding NewMapCommand}" InputGesture="Ctrl+N" />
            <MenuItem Header="Import map…" Command="{Binding ImportMapCommand}" InputGesture="Ctrl+I" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:MapItem">
            <TextBlock Text="{Binding Display}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" Margin="0,4,0,0">
        <Button Content="New level…" Command="{Binding NewMapCommand}" ToolTip.Tip="Ctrl+N" />
        <Button Content="Import map…" Command="{Binding ImportMapCommand}"
                ToolTip.Tip="Ctrl+I: planes from a WDC .map (or an ECWolf .wad) onto this level, or as a new level; pick which planes" />
      </WrapPanel>
      <TextBlock Grid.Row="3" Text="Mods (loaded over pfwolf.pk3, later ones win)" FontWeight="SemiBold" Margin="0,12,0,4" TextWrapping="Wrap" />
      <ListBox Grid.Row="4" ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}" Height="90">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Remove" Command="{Binding RemoveModCommand}" />
            <Separator />
            <MenuItem Header="New mod…" Command="{Binding NewModCommand}" />
            <MenuItem Header="Add pk3…" Click="AddModFile" />
            <MenuItem Header="Add folder…" Click="AddModFolder" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Text="{Binding}" ToolTip.Tip="{Binding}" TextTrimming="LeadingCharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <WrapPanel Grid.Row="5" Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" Margin="0,4,0,0">
        <Button Content="New mod…" Command="{Binding NewModCommand}"
                ToolTip.Tip="A new pk3: a stand-alone game (needing no other game's files) or a mod of one of PFWolf's games" />
        <Button Content="Add pk3…" Click="AddModFile" />
        <Button Content="Add folder…" Click="AddModFolder" />
        <Button Content="Remove" Command="{Binding RemoveModCommand}" />
      </WrapPanel>
    </Grid>

    <!-- The plane being edited, what's put down, and which layers show -->
    <Grid DockPanel.Dock="Right" Width="280" Margin="8" RowDefinitions="Auto,Auto,Auto,*,Auto">
      <StackPanel Grid.Row="0" Spacing="4">
        <TextBlock Text="Edit" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding Planes}" SelectedItem="{Binding SelectedPlane}" HorizontalAlignment="Stretch" />
      </StackPanel>

      <TextBox Grid.Row="1" Text="{Binding PaletteFilter}" PlaceholderText="Find in the palette" Margin="0,8,0,4"
               IsVisible="{Binding HasPalette}" />

      <StackPanel Grid.Row="2" Spacing="4" Margin="0,8,0,0">
        <!-- Planes 2 to 5: a number (the flats picked from their tables) -->
        <StackPanel Spacing="4" IsVisible="{Binding !HasPalette}">
          <StackPanel Spacing="4" IsVisible="{Binding IsFlatsPlane}">
            <TextBlock Text="Floor flat" />
            <ComboBox ItemsSource="{Binding FlatFloorOptions}" SelectedItem="{Binding SelectedFlatFloor}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Ceiling flat" />
            <ComboBox ItemsSource="{Binding FlatCeilingOptions}" SelectedItem="{Binding SelectedFlatCeiling}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <TextBlock Text="Value" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <NumericUpDown Value="{Binding PlaneValue}" Minimum="0" Maximum="65535" Increment="1" FormatString="0" />
            <Button Grid.Column="1" Content="Next unused" Command="{Binding NextUnusedCommand}" IsVisible="{Binding HasNextUnused}" />
          </Grid>
          <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12" Text="{Binding PlaneHint}" />
        </StackPanel>

        <!-- A thing class: which way it faces, its skills, patrolling -->
        <StackPanel Spacing="4" IsVisible="{Binding HasThingOptions}">
          <Grid ColumnDefinitions="60,*" RowDefinitions="Auto,Auto" RowSpacing="4">
            <TextBlock Text="Facing" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding FacingOptions}" SelectedItem="{Binding SelectedFacing}" HorizontalAlignment="Stretch" />
            <TextBlock Grid.Row="1" Text="Skill" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SkillOptions}" SelectedItem="{Binding SelectedSkill}" HorizontalAlignment="Stretch" />
          </Grid>
          <CheckBox Content="Patrols" IsChecked="{Binding ThingPatrols}" IsVisible="{Binding CanPatrol}" />
        </StackPanel>
      </StackPanel>

      <ListBox Grid.Row="3" ItemsSource="{Binding PaletteItems}" SelectedItem="{Binding SelectedPaletteItem}"
               IsVisible="{Binding HasPalette}">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Edit its map definition…" Command="{Binding EditPaletteDefinitionCommand}"
                      ToolTip.Tip="Opens the definitions window on the mapdefs entry for what's picked" />
            <MenuItem Header="Edit its actor class…" Command="{Binding EditPaletteClassCommand}"
                      ToolTip.Tip="Opens the definitions window on the thing's actordefs class" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="6,2" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PaletteItem">
            <Grid ColumnDefinitions="36,*" ColumnSpacing="8">
              <Image Grid.Column="0" Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapInterpolationMode="None" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Group}" FontSize="11" Opacity="0.6" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Which layers the map shows (the View menu has them too, and the 3D view's) -->
      <StackPanel Grid.Row="4" Spacing="2" Margin="0,8,0,0">
        <TextBlock Text="Show" FontWeight="SemiBold" Margin="0,0,0,2" />
        <WrapPanel>
          <CheckBox Content="Walls" IsChecked="{Binding ShowWalls}" MinWidth="90" />
          <CheckBox Content="Things" IsChecked="{Binding ShowThings}" MinWidth="90" />
          <CheckBox Content="Flats" IsChecked="{Binding ShowFlats}" MinWidth="90" />
          <CheckBox Content="Heights" IsChecked="{Binding ShowHeights}" MinWidth="90" />
          <CheckBox Content="Tags" IsChecked="{Binding ShowTags}" MinWidth="90" />
          <CheckBox Content="Zones" IsChecked="{Binding ShowZones}" MinWidth="90" ToolTip.Tip="Light zones" />
        </WrapPanel>
      </StackPanel>
    </Grid>

    <!-- The tools, in groups: selecting, drawing, picking -->
    <Border DockPanel.Dock="Left" BorderThickness="1,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" Padding="2,4">
      <ListBox ItemsSource="{Binding Tools}" SelectedItem="{Binding SelectedTool}" Background="Transparent" Padding="0">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="vm:ToolOption">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="{Binding Spacing}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="ToolTip.Tip" Value="{Binding ToolTip}" />
            <Setter Property="ToolTip.Placement" Value="Right" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ToolOption">
            <PathIcon Data="{Binding Icon}" Width="20" Height="20" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- The map, and the 3D view beside it (F3) -->
    <Grid x:Name="Views" ColumnDefinitions="*,Auto,*">
      <r:MapCanvas x:Name="Canvas" Grid.Column="0"
                   Tiles="{Binding Tiles}" Art="{Binding Art}" Controller="{Binding Controller}"
                   ShowWalls="{Binding ShowWalls}" ShowThings="{Binding ShowThings}"
                   ShowFlats="{Binding ShowFlats}" ShowHeights="{Binding ShowHeights}"
                   ShowTags="{Binding ShowTags}" ShowZones="{Binding ShowZones}"
                   ShowGrid="{Binding ShowGrid}"
                   Camera="{Binding Camera}" ShowCamera="{Binding Show3D}"
                   TileHovered="OnTileHovered" ToolKeyPressed="OnToolKeyPressed" />
      <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" IsVisible="{Binding Show3D}"
                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Panel Grid.Column="2" IsVisible="{Binding Show3D}">
        <r:LevelView3D x:Name="View3D"
                       Tiles="{Binding Tiles}" Art="{Binding Art}" Controller="{Binding Controller}" Camera="{Binding Camera}"
                       ShowThings="{Binding Show3DThings}" ShowCeilings="{Binding Show3DCeilings}"
                       ShowShading="{Binding Show3DShading}" ShowMarkers="{Binding Show3DMarkers}"
                       SurfaceHovered="OnSurfaceHovered" Failed="On3DFailed" ToolKeyPressed="OnToolKeyPressed" />
        <TextBlock Text="Left button: the tool on the tile under the pointer (things, and anything with Shift, go in front of a wall face) · Delete erases it · WASD fly · Q/E down/up · Shift faster · right drag look · middle drag slide · wheel forward · V on the map moves the camera"
                   Margin="8,6" FontSize="11" Opacity="0.75" Foreground="White" TextWrapping="Wrap"
                   VerticalAlignment="Bottom" IsHitTestVisible="False" />
      </Panel>

      <!-- While the game loads: what it's doing (and the map can't be clicked) -->
      <Border Grid.ColumnSpan="3" IsVisible="{Binding IsLoading}" Background="#A0101014">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,18" CornerRadius="6" MinWidth="320"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
          <StackPanel Spacing="10">
            <TextBlock Text="Loading the game" FontWeight="SemiBold" FontSize="16" />
            <ProgressBar IsIndeterminate="True" />
            <TextBlock Text="{Binding LoadingStep}" Opacity="0.75" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </DockPanel>
</Window>
