<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PFWolf.Editor.ViewModels"
        xmlns:data="using:PFWolf.Editor.Data"
        xmlns:v="using:PFWolf.Editor.Views"
        xmlns:sys="using:System"
        x:Class="PFWolf.Editor.Views.ActorBrowserWindow"
        x:DataType="vm:ActorBrowserViewModel"
        Title="{Binding Title}"
        Width="1280" Height="880" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,8,0,2" />
    </Style>
    <Style Selector="Border.frame">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.frame.current">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- What's listed -->
    <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
        <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" MinWidth="200" />
        <TextBox x:Name="Search" Grid.Column="1" Text="{Binding Filter}" VerticalAlignment="Center"
                 PlaceholderText="Find by name, a parent, a sprite, a think or an action (Guard, Monster, GARD, T_Chase)" />
        <TextBlock Grid.Column="2" Text="{Binding CountText}" VerticalAlignment="Center" Opacity="0.7" MinWidth="110" />
        <DropDownButton Grid.Column="3" Content="New actor" ToolTip.Tip="A new class, not saved until you save it">
          <DropDownButton.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Built on this one…" Command="{Binding NewChildCommand}"
                        ToolTip.Tip="parent: the class picked. It has all the picked one has (and what it's changed to later), and changes only what's set on it" />
              <MenuItem Header="A copy of this one…" Command="{Binding NewCopyCommand}"
                        ToolTip.Tip="Written as the picked class is (its own fields, the same parent), so changing the picked one later leaves it be" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
      </Grid>
    </Border>

    <!-- What's been done -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Opacity="0.8" ToolTip.Tip="{Binding Status}" />
    </Border>

    <!-- Every class -->
    <ListBox x:Name="List" DockPanel.Dock="Left" Width="280" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="8,8,0,8">
      <ListBox.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Save" Command="{Binding SaveClassCommand}" InputGesture="Ctrl+S" />
          <MenuItem Header="Revert" Command="{Binding RevertClassCommand}" />
          <Separator />
          <MenuItem Header="New actor built on this…" Command="{Binding NewChildCommand}" />
          <MenuItem Header="Copy as a new actor…" Command="{Binding NewCopyCommand}" />
          <MenuItem Header="Take out the mod's change…" Command="{Binding TakeOutClassCommand}" />
          <Separator />
          <MenuItem Header="Open in the Definitions window" Command="{Binding EditInDefinitionsCommand}" />
          <MenuItem Header="Copy name" Command="{Binding CopyNameCommand}" />
        </ContextMenu>
      </ListBox.ContextMenu>
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="8,3" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ActorItem">
          <Grid ColumnDefinitions="*,Auto,Auto" ToolTip.Tip="{Binding ToolTip}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="⚠" Foreground="#E0A030" IsVisible="{Binding HasProblems}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding KindText}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
            <TextBlock Grid.Column="2" Text="●" Foreground="Orange" IsVisible="{Binding HasEdits}" VerticalAlignment="Center" Margin="6,0,0,0"
                       ToolTip.Tip="Changed, not saved" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- The class picked: its preview and states stay in view, the rest in tabs under them -->
    <DockPanel Margin="8" IsVisible="{Binding HasSelection}">
      <StackPanel DockPanel.Dock="Top" Spacing="4">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
          <StackPanel>
            <SelectableTextBlock Text="{Binding SelectedItem.Name, FallbackValue=''}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Details}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Lineage}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" ToolTip.Tip="What it's built on, from the root down" />
            <TextBlock Text="{Binding FieldSource}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="Changed, not saved" FontSize="12" Opacity="0.7" VerticalAlignment="Top" Margin="0,8,0,0" IsVisible="{Binding IsChanged}" />
          <Button Grid.Column="2" Content="Save" Command="{Binding SaveClassCommand}" Classes="accent" VerticalAlignment="Top"
                  ToolTip.Tip="Ctrl+S: into the mod with its own of it, else one you pick; just what's changed (pfwolf.pk3 is read-only)" />
          <Button Grid.Column="3" Content="Revert" Command="{Binding RevertClassCommand}" VerticalAlignment="Top" ToolTip.Tip="Back to the class as the files have it" />
          <Button Grid.Column="4" Content="Undo" Command="{Binding UndoClassCommand}" VerticalAlignment="Top" ToolTip.Tip="Ctrl+Z (outside a field)" />
          <Button Grid.Column="5" Content="Redo" Command="{Binding RedoClassCommand}" VerticalAlignment="Top" ToolTip.Tip="Ctrl+Y (outside a field)" />
          <DropDownButton Grid.Column="6" Content="More" VerticalAlignment="Top">
            <DropDownButton.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Show sprite" Command="{Binding ShowSpriteCommand}"
                          ToolTip.Tip="The sprite the preview shows, in the textures and sprites window (F6)" />
                <MenuItem Header="Open in the Definitions window" Command="{Binding EditInDefinitionsCommand}"
                          ToolTip.Tip="Its actordefs entry in the Definitions window (F11): its states as fields, its YAML" />
                <MenuItem Header="Take out the mod's change…" Command="{Binding TakeOutClassCommand}"
                          ToolTip.Tip="Takes the last mod's say in this class out of its actordefs, so it's what the game (and the mods before) make it" />
                <MenuItem Header="Copy name" Command="{Binding CopyNameCommand}" />
              </MenuFlyout>
            </DropDownButton.Flyout>
          </DropDownButton>
        </Grid>

        <!-- The preview: as the game plays it -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,6,0,0">
          <Border Background="#383838" CornerRadius="4" Width="{Binding PreviewBoxWidth}" Height="{Binding PreviewBoxHeight}" ClipToBounds="True"
                  VerticalAlignment="Top">
            <Grid>
              <Image x:Name="Preview" Source="{Binding PreviewImage}" Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" Stretch="Fill"
                     RenderOptions.BitmapInterpolationMode="None" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                     ToolTip.Tip="The frame as the game draws it, from the view picked" />
              <TextBlock Text="{Binding PictureText}" Foreground="White" FontSize="11" Margin="6,4" Opacity="0.85" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Spacing="6">
            <WrapPanel ItemSpacing="6" LineSpacing="6">
              <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" MinWidth="150"
                        ToolTip.Tip="The state to play, from its first frame" />
              <Button Command="{Binding PlayPauseCommand}" ToolTip.Tip="Play or pause (Space)" MinWidth="70">
                <Panel>
                  <TextBlock Text="Pause" IsVisible="{Binding Playing}" />
                  <TextBlock Text="Play" IsVisible="{Binding !Playing}" />
                </Panel>
              </Button>
              <Button Content="Next frame" Command="{Binding StepFrameCommand}" ToolTip.Tip="On to the frame after this one, its actions told (Right arrow)" />
              <Button Content="Restart" Command="{Binding RestartCommand}" ToolTip.Tip="The state from its first frame again (Home)" />
              <ComboBox ItemsSource="{Binding Speeds}" SelectedItem="{Binding SelectedSpeed}" ToolTip.Tip="How fast: 1× is the game's 70 tics a second" />
              <CheckBox Content="Follow next-state" IsChecked="{Binding FollowNext}"
                        ToolTip.Tip="Going on into the state its frames lead to (Attack into Chase), as the game does; off, the state picked plays again" />
              <TextBlock Text="Zoom" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding Zoom}" Minimum="1" Maximum="6" Increment="1" FormatString="0" Width="100" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" IsEnabled="{Binding Turns}">
              <TextBlock Text="View" VerticalAlignment="Center" />
              <ListBox ItemsSource="{Binding Views}" SelectedItem="{Binding SelectedView}" Background="Transparent"
                       ToolTip.Tip="Which side it's seen from: 1 its front, 3 its left side, 5 its back, 7 its right side (a sprite with one view looks the same from every side)">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2" />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="9,3" />
                    <Setter Property="MinWidth" Value="0" />
                  </Style>
                </ListBox.Styles>
              </ListBox>
              <TextBlock Text="(one view only)" VerticalAlignment="Center" Opacity="0.6" IsVisible="{Binding !Turns}" />
            </StackPanel>
            <TextBlock Text="{Binding TicText}" Opacity="0.85" />
            <TextBlock Text="{Binding RunningText}" Opacity="0.85" TextWrapping="Wrap" />
            <TextBlock Text="{Binding EventText}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsStuck}">
              <TextBlock Text="{Binding JumpText}" Foreground="#E0A030" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Go on" Command="{Binding GoOnCommand}" />
            </Grid>
            <TextBlock Text="{Binding KeyNumbers}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <!-- The state's frames, each as wide as its tics -->
        <TextBlock Classes="heading" Text="Frames of the state (click one to look at it)" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="3">
            <ItemsControl x:Name="Timeline" ItemsSource="{Binding Timeline}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TimelineFrame">
                  <Border Classes="frame" Classes.current="{Binding IsCurrent}" Width="{Binding Width}" ToolTip.Tip="{Binding ToolTip}"
                          PointerPressed="OnFramePressed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                      <TextBlock Text="{Binding Letter}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Tics}" FontSize="11" Opacity="0.8" />
                        <TextBlock Text="✦" FontSize="11" IsVisible="{Binding HasAction}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding TimelineEnd}" VerticalAlignment="Center" Opacity="0.75" Margin="6,0,0,0" />
          </StackPanel>
        </ScrollViewer>
        <TextBlock Text="{Binding FrameText}" Opacity="0.8" FontSize="12" TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding Problems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <TextBlock Text="{Binding StringFormat='⚠ {0}'}" TextWrapping="Wrap" Foreground="#E0A030" FontSize="12" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Notes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <TextBlock Text="{Binding}" TextWrapping="Wrap" Opacity="0.6" FontSize="12" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <TabControl Margin="0,6,0,0">
        <!-- Its own fields, to change; what its parents give it under them -->
        <TabItem Header="Fields">
          <ScrollViewer Margin="0,4,0,0">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <TextBlock Text="Add property" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding AddableProperties}" SelectedItem="{Binding PropertyToAdd}" MaxWidth="420"
                          HorizontalAlignment="Left" MinWidth="260" PlaceholderText="One its kind reads"
                          ToolTip.Tip="A property this kind of actor reads that it doesn't set: shown under properties, empty, to fill in">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PropertyChoice">
                      <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Description}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </Grid>
              <TextBlock Text="{Binding FieldError}" Foreground="OrangeRed" TextWrapping="Wrap" IsVisible="{Binding HasFieldError}" />
              <v:FieldTree Rows="{Binding FieldRows}" />
              <TextBlock Classes="heading" Text="From its parents" />
              <TextBlock TextWrapping="Wrap" FontSize="12">
                <Run Text="Flags, all: " FontWeight="SemiBold" /><Run Text="{Binding FlagsText}" />
              </TextBlock>
              <ItemsControl ItemsSource="{Binding Properties}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ActorPropertyRow">
                    <Grid ColumnDefinitions="260,*,Auto" ColumnSpacing="8" Margin="0,1" ToolTip.Tip="{Binding Description}">
                      <TextBlock Text="{Binding Key}" Opacity="0.75" FontSize="12" TextTrimming="CharacterEllipsis" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="2" Text="{Binding From, StringFormat='from {0}'}" FontSize="12" Opacity="0.55"
                                 IsVisible="{Binding !IsOwn}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- What names it -->
        <TabItem Header="Used by">
          <DockPanel Margin="0,4,0,0">
            <WrapPanel DockPanel.Dock="Bottom" ItemSpacing="6" LineSpacing="6" Margin="0,8,0,0">
              <Button Content="Go to" Command="{Binding GoToUseCommand}"
                      ToolTip.Tip="Opens the use picked: the class here, its entry in the Definitions window, its line in the script browser, or the level at the first one placed (or double-click it)" />
            </WrapPanel>
            <ListBox ItemsSource="{Binding Uses}" SelectedItem="{Binding SelectedUse}" DoubleTapped="OnUseDoubleTapped">
              <ListBox.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Go to" Command="{Binding GoToUseCommand}" />
                </ContextMenu>
              </ListBox.ContextMenu>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="8,3" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="data:ActorUse">
                  <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="12" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>

        <!-- Where it's defined -->
        <TabItem Header="Defined in">
          <DockPanel Margin="0,4,0,0">
            <WrapPanel DockPanel.Dock="Bottom" ItemSpacing="6" LineSpacing="6" Margin="0,8,0,0">
              <Button Content="Open in the Definitions window" Command="{Binding EditInDefinitionsCommand}"
                      ToolTip.Tip="Its entry in the Definitions window's Actors tab: the files it comes from, each one's YAML" />
            </WrapPanel>
            <ScrollViewer>
              <StackPanel Spacing="4">
                <ItemsControl ItemsSource="{Binding DefinedIn}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                      <TextBlock Text="{Binding}" FontSize="12" Opacity="0.8" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <SelectableTextBlock Text="{Binding DefinitionYaml}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Opacity="0.85" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
      </TabControl>
    </DockPanel>
  </DockPanel>
</Window>
