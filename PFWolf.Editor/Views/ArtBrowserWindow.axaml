<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PFWolf.Editor.ViewModels"
        xmlns:data="using:PFWolf.Editor.Data"
        x:Class="PFWolf.Editor.Views.ArtBrowserWindow"
        x:DataType="vm:ArtBrowserViewModel"
        Title="{Binding Title}"
        Width="1180" Height="760" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner">

  <DockPanel>
    <!-- What's listed -->
    <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,140,Auto,Auto,Auto" ColumnSpacing="8">
        <ComboBox Grid.Column="0" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" MinWidth="170" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Shows}" SelectedItem="{Binding SelectedShow}" MinWidth="140"
                  ToolTip.Tip="In use: a mapdefs wall, door or flat, an actordefs class or a level's sky shows it" />
        <TextBox x:Name="Search" Grid.Column="2" Text="{Binding Filter}" VerticalAlignment="Center"
                 PlaceholderText="Find by name, or by what uses it (guard, door 90, floor flat)" />
        <TextBlock Grid.Column="3" Text="Size" VerticalAlignment="Center" />
        <Slider Grid.Column="4" Minimum="32" Maximum="160" Value="{Binding ThumbSize}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="5" Text="{Binding CountText}" VerticalAlignment="Center" Opacity="0.7" MinWidth="120" />
        <Button Grid.Column="6" Content="Add…" Click="AddPictures"
                ToolTip.Tip="Puts PNG or BMP files in a mod as wall textures, flats, sprites or pictures, named by their file names" />
        <Button Grid.Column="7" Content="New…" Click="NewPicture"
                ToolTip.Tip="Draws a new picture in the pixel editor; saving it puts it in a mod" />
      </Grid>
    </Border>

    <!-- What the last change did, and the pictures open in other programs -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" FontSize="12" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding WatchingText}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
        <Button Grid.Column="2" Content="Stop watching" Command="{Binding StopWatchingCommand}" FontSize="12" Padding="8,2"
                IsVisible="{Binding IsWatching}"
                ToolTip.Tip="Stops watching the pictures opened in other programs (their copies in the temp folder are removed)" />
      </Grid>
    </Border>

    <!-- A picture was saved in the other program -->
    <Border DockPanel.Dock="Bottom" Padding="8,6" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" IsVisible="{Binding HasSavedOutside}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Text="{Binding SavedOutsideText}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <CheckBox Grid.Column="1" Content="Bring saves in at once" IsChecked="{Binding BringInAtOnce}"
                  ToolTip.Tip="Each save in the other program goes into the mod straight away (the game loads again each time)" />
        <Button Grid.Column="2" Content="Bring it in" Command="{Binding BringInCommand}" Classes="accent"
                ToolTip.Tip="Puts the picture saved there in its mod, in place of the one it was opened from" />
        <Button Grid.Column="3" Content="Not now" Command="{Binding NotNowCommand}" />
      </Grid>
    </Border>

    <!-- The picture picked: big, its details, where it came from, what uses it -->
    <Grid DockPanel.Dock="Right" Width="380" Margin="8" RowDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          IsVisible="{Binding HasSelection}">
      <Border Grid.Row="0" Background="{Binding SelectedBackground.Brush}" CornerRadius="4" ClipToBounds="True">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Image Source="{Binding Preview}" Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" Margin="8"
                 Stretch="Fill" RenderOptions.BitmapInterpolationMode="None"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ScrollViewer>
      </Border>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6" Margin="0,6,0,0">
        <TextBlock Text="Zoom" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Zooms}" SelectedItem="{Binding Zoom}" MinWidth="70">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="x:Int32">
              <TextBlock Text="{Binding StringFormat='{}{0}×'}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox Grid.Column="2" ItemsSource="{Binding Backgrounds}" SelectedItem="{Binding SelectedBackground}" MinWidth="120"
                  ToolTip.Tip="The colour behind the picture, which shows through a sprite's see-through pixels" />
      </Grid>

      <!-- A rotating sprite's sides: pick one, or turn it with the arrows (comma and full stop) -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4" Margin="0,6,0,0" IsVisible="{Binding HasRotations}">
        <Button Content="◀" Command="{Binding TurnCommand}" CommandParameter="-1" VerticalAlignment="Stretch"
                ToolTip.Tip="The side before (,)" />
        <ListBox Grid.Column="1" ItemsSource="{Binding Rotations}" SelectedItem="{Binding SelectedRotation}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" Padding="0"
                 ToolTip.Tip="Which side of the frame shows: 1 faces you, 5 faces away, the others turn in between">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="2" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RotationItem">
              <StackPanel Width="34" Spacing="1">
                <Border Background="{Binding $parent[Window].((vm:ArtBrowserViewModel)DataContext).SelectedBackground.Brush}" Height="34">
                  <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                </Border>
                <TextBlock Text="{Binding Side}" FontSize="11" HorizontalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Column="2" Content="▶" Command="{Binding TurnCommand}" CommandParameter="1" VerticalAlignment="Stretch"
                ToolTip.Tip="The side after (.)" />
      </Grid>

      <SelectableTextBlock Grid.Row="3" Text="{Binding SelectedItem.Name, FallbackValue=''}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
      <StackPanel Grid.Row="4" Spacing="4">
        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Opacity="0.8" />
        <TextBlock Text="{Binding FileText}" TextWrapping="Wrap" Opacity="0.6" FontSize="12" />
        <!-- A sprite's offset: its PNG's grAb chunk -->
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsSprite}">
          <TextBlock Text="Offset" VerticalAlignment="Center"
                     ToolTip.Tip="The sprite's X, Y offset, kept in its PNG's grAb chunk as ZDoom and SLADE write it" />
          <NumericUpDown Value="{Binding OffsetX}" Minimum="-4096" Maximum="4096" Increment="1" FormatString="0" Width="110" />
          <NumericUpDown Value="{Binding OffsetY}" Minimum="-4096" Maximum="4096" Increment="1" FormatString="0" Width="110" />
          <Button Content="Set" Command="{Binding ApplyOffsetCommand}"
                  ToolTip.Tip="Saves the offset in the sprite's PNG (grAb), in its mod or, for the game's own, in a mod picked" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="5" Spacing="4" Margin="0,8,0,0">
        <TextBlock Text="Where it comes from (the last one is used)" FontWeight="SemiBold" />
        <ListBox ItemsSource="{Binding Origins}" MaxHeight="90">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" ToolTip.Tip="{Binding}" TextTrimming="CharacterEllipsis" FontSize="12" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <StackPanel Grid.Row="6" Spacing="4" Margin="0,8,0,0">
        <TextBlock Text="Used by" FontWeight="SemiBold" />
        <ListBox ItemsSource="{Binding Uses}" SelectedItem="{Binding SelectedUse}" MaxHeight="150" DoubleTapped="OnUseDoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="data:ArtUse">
              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="12" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="Nothing in mapdefs, actordefs or game-info shows it." Opacity="0.6" FontSize="12"
                   IsVisible="{Binding !HasUses}" />
      </StackPanel>

      <WrapPanel Grid.Row="7" ItemSpacing="6" LineSpacing="6" Margin="0,8,0,0">
        <Button Content="Use in palette" Command="{Binding UseInPaletteCommand}" Classes="accent"
                ToolTip.Tip="Picks the wall, door, flat or thing chosen under Used by to put down on the map (or double-click it)" />
        <Button Content="Copy name" Click="CopyName" />
        <Button Content="Export PNG…" Click="ExportPng" ToolTip.Tip="Saves the picture in the game's palette as a PNG" />
        <Button Content="Replace…" Click="ReplacePicture"
                ToolTip.Tip="Puts a PNG or BMP in its place: over its file in its mod, or, for the game's own, as a file of the same name in a mod" />
        <Button Content="Rename…" Command="{Binding RenameCommand}"
                ToolTip.Tip="Renames its file in its mod (only a mod's own pictures)" />
        <Button Content="Delete" Command="{Binding DeleteCommand}"
                ToolTip.Tip="Takes its file out of its mod (only a mod's own pictures); the game's own of that name shows again" />
        <Button Content="Edit pixels" Command="{Binding EditPixelsCommand}"
                ToolTip.Tip="Draws on it in the pixel editor, in the game palette; saving puts it in its mod (or, for the game's own, a mod picked)" />
        <Button Content="Edit outside" Command="{Binding EditOutsideCommand}"
                ToolTip.Tip="{Binding ImageEditorText, StringFormat='{}Opens it as a PNG in a paint program and watches for it being saved there. {0}.'}" />
        <Button Content="Paint program ▾"
                ToolTip.Tip="{Binding ImageEditorText, StringFormat='{}The program Edit outside opens pictures in. {0}.'}">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Pick a program…" Click="PickImageEditor" />
              <MenuItem Header="The one Windows edits PNGs with" Click="UseDefaultImageEditor" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </WrapPanel>
    </Grid>

    <!-- Every picture listed -->
    <ListBox x:Name="Thumbs" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="8,8,0,8"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="4" />
          <Setter Property="Margin" Value="2" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ArtItem">
          <StackPanel Spacing="2" ToolTip.Tip="{Binding ToolTip}"
                      Width="{Binding $parent[ListBox].((vm:ArtBrowserViewModel)DataContext).ThumbSize}">
            <Border Background="{Binding $parent[ListBox].((vm:ArtBrowserViewModel)DataContext).SelectedBackground.Brush}"
                    Height="{Binding $parent[ListBox].((vm:ArtBrowserViewModel)DataContext).ThumbSize}">
              <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
            </Border>
            <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding SidesText}" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" IsVisible="{Binding IsRotating}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
