<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PFWolf.Editor.ViewModels"
        xmlns:views="using:PFWolf.Editor.Views"
        xmlns:editor="using:PFWolf.Editor"
        x:Class="PFWolf.Editor.Views.SplashWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PFWolf Editor"
        Width="600" Height="340" CanResize="False"
        SystemDecorations="None" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen">

  <!-- The startup splash: who made the editor, and the game loading at the bottom.
       A click or Esc closes it early (SplashWindow.axaml.cs) -->
  <Border BorderBrush="#06162e" BorderThickness="2">
    <Grid RowDefinitions="*,Auto">
      <views:BlueprintBackground Grid.RowSpan="2" />

      <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="28,28,28,16">
        <Image Grid.Column="0" Source="/Assets/pfwolf-editor-256.png" Width="168" Height="168"
               VerticalAlignment="Top" Margin="0,0,28,0" />

        <DockPanel Grid.Column="1">
          <StackPanel DockPanel.Dock="Top" Spacing="2">
            <TextBlock Text="{x:Static editor:EditorInfo.Name}" FontSize="30" FontWeight="Bold" Foreground="White" />
            <TextBlock Foreground="#d9dbe0" FontSize="14">
              <Run Text="Version" />
              <Run Text="{x:Static editor:EditorInfo.Version}" />
            </TextBlock>
            <TextBlock Foreground="#d9dbe0" FontSize="14" Margin="0,6,0,0">
              <Run Text="by" />
              <Run Text="{x:Static editor:EditorInfo.Authors}" />
            </TextBlock>
            <TextBlock Text="{x:Static editor:EditorInfo.Copyright}" Foreground="#d9dbe0" FontSize="12" Opacity="0.85" />
            <HyperlinkButton Content="{x:Static editor:EditorInfo.Website}" NavigateUri="{x:Static editor:EditorInfo.Website}"
                             Foreground="#f7b928" Padding="0" Margin="0,2,0,0" FontSize="12" />
          </StackPanel>

          <TextBlock DockPanel.Dock="Bottom" Text="{x:Static editor:EditorInfo.Runtime}"
                     Foreground="#d9dbe0" Opacity="0.55" FontSize="11" Margin="0,6,0,0" />

          <StackPanel Margin="0,12,0,0" Spacing="2">
            <TextBlock Text="Credits" Foreground="White" FontWeight="SemiBold" FontSize="12" />
            <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{x:Static editor:EditorInfo.Credits}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" Foreground="#d9dbe0" FontSize="12" TextWrapping="Wrap" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </DockPanel>
      </Grid>

      <!-- The game loading: the main window's status and its current step -->
      <Border Grid.Row="1" Background="#A0061226" Padding="16,8">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Status}" Foreground="White" FontSize="12"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LoadingStep}" Foreground="#d9dbe0" FontSize="11"
                     Opacity="0.75" TextTrimming="CharacterEllipsis" />
          <ProgressBar Grid.RowSpan="2" Grid.Column="1" IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                       Width="120" MinWidth="0" VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
