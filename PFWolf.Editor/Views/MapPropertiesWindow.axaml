<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PFWolf.Editor.ViewModels"
        xmlns:views="using:PFWolf.Editor.Views"
        x:Class="PFWolf.Editor.Views.MapPropertiesWindow"
        x:DataType="vm:MapPropertiesViewModel"
        Title="{Binding Title}"
        Width="960" Height="720" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,4" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <TextBlock Text="{Binding Error}" Foreground="OrangeRed" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="OK" IsDefault="True" Classes="accent" Click="OnOk" />
        <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer>
      <StackPanel Spacing="4" Margin="0,0,12,0">
        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                   Text="Saved into the mod's game-info.yaml with the level. A field left empty uses the default map's value (shown faded)." />

        <TextBlock Classes="heading" Text="The level" />
        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
          <TextBlock Classes="label" Grid.Row="5" Text="Floor number" />
          <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding FloorNumber}" PlaceholderText="0"
                   ToolTip.Tip="The level's floor in its mission or episode (&quot;Floor Y&quot; in its name when it has none); Blake Stone's elevators, teleporters and map-info links go by it" />
          <TextBlock Classes="label" Grid.Row="6" Text="Cluster" />
          <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Cluster}" PlaceholderText="{Binding ClusterHint}"
                   ToolTip.Tip="The game-info cluster the level is in (a Blake Stone mission, a hub of floors kept as they're left)" />
          <TextBlock Classes="label" Grid.Row="0" Text="Name" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" PlaceholderText="Episode X, Floor Y" />
          <TextBlock Classes="label" Grid.Row="1" Text="Music" />
          <AutoCompleteBox Grid.Row="1" Grid.Column="1" Text="{Binding Music}" ItemsSource="{Binding MusicNames}" FilterMode="ContainsOrdinal" />
          <TextBlock Classes="label" Grid.Row="2" Text="Next level" />
          <AutoCompleteBox Grid.Row="2" Grid.Column="1" Text="{Binding Next}" ItemsSource="{Binding MapNames}" FilterMode="StartsWith"
                           ToolTip.Tip="Empty: finishing this level ends the episode" />
          <TextBlock Classes="label" Grid.Row="3" Text="Secret next level" />
          <AutoCompleteBox Grid.Row="3" Grid.Column="1" Text="{Binding SecretNext}" ItemsSource="{Binding MapNames}" FilterMode="StartsWith" />
          <TextBlock Classes="label" Grid.Row="4" Text="Par time (seconds)" />
          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ParTime}" />
        </Grid>

        <StackPanel IsVisible="{Binding HasSize}" Spacing="4">
          <TextBlock Classes="heading" Text="Size (tiles)" />
          <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                     Text="Part of the level itself, not game-info: OK resizes it (Level → Resize level…, Ctrl+R, does just this)." />
          <views:MapSizeView DataContext="{Binding Size}" />
        </StackPanel>

        <TextBlock Classes="heading" Text="How it looks" />
        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
          <TextBlock Classes="label" Grid.Row="0" Text="Floor color" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FloorColor}" PlaceholderText="{Binding FloorColorDefault}" />
          <TextBlock Classes="label" Grid.Row="1" Text="Ceiling color" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CeilingColor}" PlaceholderText="{Binding CeilingColorDefault}" />
          <TextBlock Classes="label" Grid.Row="2" Text="Wall height (stories)" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WallHeight}" PlaceholderText="{Binding WallHeightDefault}" />
          <TextBlock Classes="label" Grid.Row="3" Text="Sky" />
          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Sky}" PlaceholderText="{Binding SkyDefault}" />
          <TextBlock Classes="label" Grid.Row="4" Text="Default floor flat" />
          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DefaultFloor}" PlaceholderText="{Binding DefaultFloorDefault}" />
          <TextBlock Classes="label" Grid.Row="5" Text="Default ceiling flat" />
          <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DefaultCeiling}" PlaceholderText="{Binding DefaultCeilingDefault}" />
          <TextBlock Classes="label" Grid.Row="6" Text="Weather" />
          <AutoCompleteBox Grid.Row="6" Grid.Column="1" Text="{Binding Weather}" ItemsSource="{Binding WeatherNames}" FilterMode="Contains"
                           Watermark="{Binding WeatherDefault}"
                           ToolTip.Tip="Rain or snow; none in place of the default map's. It doesn't fall under ceiling flats or arches. Kinds are game-info weather-types (Definitions window) and the built-in rain, heavy-rain, snow and blizzard." />
        </Grid>

        <TextBlock Classes="heading" Text="Shading (night, fog)" />
        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="8">
          <TextBlock Classes="label" Grid.Row="0" Text="Light (0-255)" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Light}" PlaceholderText="{Binding LightDefault}" />
          <TextBlock Classes="label" Grid.Row="1" Text="Fade color" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FadeColor}" PlaceholderText="{Binding FadeColorDefault}" />
          <TextBlock Classes="label" Grid.Row="2" Text="Fade start (tiles)" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FadeStart}" PlaceholderText="{Binding FadeStartDefault}" />
          <TextBlock Classes="label" Grid.Row="3" Text="Fade end (tiles)" />
          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FadeEnd}" PlaceholderText="{Binding FadeEndDefault}" />
          <TextBlock Classes="label" Grid.Row="4" Text="Max fade (%)" />
          <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MaxFade}" PlaceholderText="{Binding MaxFadeDefault}" />
        </Grid>

        <TextBlock Classes="heading" Text="Zones (plane 5)" />
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                   Text="Tiles with a zone's id on plane 5 are lit by it. Light 0-255; color #RRGGBB tints it; an effect moves between low and the light every tics (70 a second). Ambient is a sound looped while the player is in the zone (none: silence), Disguised the one played instead in disguise, Unseen while no enemy has noticed the player yet; a zone with only those keeps the level's light." />
        <Grid ColumnDefinitions="60,70,100,100,60,60,80,140,140,140,Auto" ColumnSpacing="6" Margin="0,4,0,0">
          <TextBlock Grid.Column="0" Text="Id" Opacity="0.7" />
          <TextBlock Grid.Column="1" Text="Light" Opacity="0.7" />
          <TextBlock Grid.Column="2" Text="Color" Opacity="0.7" />
          <TextBlock Grid.Column="3" Text="Effect" Opacity="0.7" />
          <TextBlock Grid.Column="4" Text="Low" Opacity="0.7" />
          <TextBlock Grid.Column="5" Text="Tics" Opacity="0.7" />
          <TextBlock Grid.Column="6" Text="Bright tics" Opacity="0.7" />
          <TextBlock Grid.Column="7" Text="Ambient" Opacity="0.7" />
          <TextBlock Grid.Column="8" Text="Disguised" Opacity="0.7" />
          <TextBlock Grid.Column="9" Text="Unseen" Opacity="0.7" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Zones}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ZoneRow">
              <Grid ColumnDefinitions="60,70,100,100,60,60,80,140,140,140,Auto" ColumnSpacing="6" Margin="0,2">
                <TextBox Grid.Column="0" Text="{Binding Id}" />
                <TextBox Grid.Column="1" Text="{Binding Light}" />
                <TextBox Grid.Column="2" Text="{Binding Color}" PlaceholderText="white" />
                <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:ZoneRow.Effects}" SelectedItem="{Binding Effect}" HorizontalAlignment="Stretch" />
                <TextBox Grid.Column="4" Text="{Binding Low}" />
                <TextBox Grid.Column="5" Text="{Binding Tics}" />
                <TextBox Grid.Column="6" Text="{Binding BrightTics}" />
                <TextBox Grid.Column="7" Text="{Binding Ambient}" />
                <TextBox Grid.Column="8" Text="{Binding AmbientDisguised}" />
                <TextBox Grid.Column="9" Text="{Binding AmbientUndetected}" />
                <Button Grid.Column="10" Content="Remove"
                        Command="{Binding $parent[ItemsControl].((vm:MapPropertiesViewModel)DataContext).RemoveZoneCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Add a zone" Command="{Binding AddZoneCommand}" Margin="0,4,0,0" />

        <TextBlock Classes="heading" Text="Scrollers (tags, plane 4)" />
        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                   Text="The textures of the tiles with a scroller's tag slide along, in texels a tic (64 a tile, 70 tics a second; negative the other way): on wall faces x right and y down, on floors and ceilings x east and y south. Door jambs, doors and patches stay put. Switches and actor states start, stop and change them (A_StartScroll, A_StopScroll, A_ToggleScroll, A_SetScroll); one not running waits for a switch." />
        <Grid ColumnDefinitions="60,70,70,60,60,60,70,Auto" ColumnSpacing="6" Margin="0,4,0,0">
          <TextBlock Grid.Column="0" Text="Tag" Opacity="0.7" />
          <TextBlock Grid.Column="1" Text="X" Opacity="0.7" />
          <TextBlock Grid.Column="2" Text="Y" Opacity="0.7" />
          <TextBlock Grid.Column="3" Text="Walls" Opacity="0.7" />
          <TextBlock Grid.Column="4" Text="Floor" Opacity="0.7" />
          <TextBlock Grid.Column="5" Text="Ceiling" Opacity="0.7" />
          <TextBlock Grid.Column="6" Text="Running" Opacity="0.7" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Scrollers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ScrollerRow">
              <Grid ColumnDefinitions="60,70,70,60,60,60,70,Auto" ColumnSpacing="6" Margin="0,2">
                <TextBox Grid.Column="0" Text="{Binding Tag}" />
                <TextBox Grid.Column="1" Text="{Binding X}" PlaceholderText="0" />
                <TextBox Grid.Column="2" Text="{Binding Y}" PlaceholderText="0" />
                <CheckBox Grid.Column="3" IsChecked="{Binding Walls}" />
                <CheckBox Grid.Column="4" IsChecked="{Binding Floor}" />
                <CheckBox Grid.Column="5" IsChecked="{Binding Ceiling}" />
                <CheckBox Grid.Column="6" IsChecked="{Binding Active}" ToolTip.Tip="Scrolling as the level starts; off waits for a switch" />
                <Button Grid.Column="7" Content="Remove"
                        Command="{Binding $parent[ItemsControl].((vm:MapPropertiesViewModel)DataContext).RemoveScrollerCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Add a scroller" Command="{Binding AddScrollerCommand}" Margin="0,4,0,0" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
