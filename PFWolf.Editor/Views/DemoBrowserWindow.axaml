<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PFWolf.Editor.ViewModels"
        xmlns:r="using:PFWolf.Editor.Rendering"
        x:Class="PFWolf.Editor.Views.DemoBrowserWindow"
        x:DataType="vm:DemoBrowserViewModel"
        Title="{Binding Title}"
        Width="1280" Height="860" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner">

  <DockPanel>
    <!-- What's been done -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Opacity="0.8" ToolTip.Tip="{Binding Status}" />
    </Border>

    <!-- Every demo -->
    <DockPanel DockPanel.Dock="Left" Width="270" Margin="8,8,0,8">
      <WrapPanel DockPanel.Dock="Bottom" ItemSpacing="6" LineSpacing="6" Margin="0,6,0,0">
        <Button Content="Open .dmo…" Click="OpenDemo" ToolTip.Tip="Lists a demo file (id's format) to look at; Ctrl+O" />
        <Button Content="Save as .dmo…" Click="SaveDemo" IsEnabled="{Binding HasSelection}"
                ToolTip.Tip="Saves the demo picked as a file: DEMO0-9.dmo in the game's demos folder plays in place of the game's own" />
      </WrapPanel>
      <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DemoItem">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ToolTip.Tip="{Binding ToolTip}" Opacity="{Binding Opacity}">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding LengthText}" Opacity="0.7" FontFamily="Consolas,Menlo,monospace" />
              <TextBlock Grid.Row="1" Text="{Binding MapText}" Opacity="0.7" FontSize="12" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SourceText}" Opacity="0.6" FontSize="12" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- The demo picked: its controls along time, and what happened -->
    <Grid Margin="8" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="6" IsVisible="{Binding HasSelection}">
      <!-- What it is, and the trace -->
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <SelectableTextBlock Text="{Binding SelectedItem.Name, FallbackValue=''}" FontSize="18" FontWeight="SemiBold" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <CheckBox Content="Path" IsChecked="{Binding ShowPath}" ToolTip.Tip="Where the player went: walked so far, then dashed where they go next" />
            <CheckBox Content="Replay" IsChecked="{Binding ShowGhosts}" ToolTip.Tip="Every actor, door and pushwall as it was at the frame shown" />
            <CheckBox Content="Events" IsChecked="{Binding ShowEvents}" ToolTip.Tip="Kills, pickups, hurts, doors and pushwalls as markers" />
          </StackPanel>
        </Grid>
        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Opacity="0.8" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Text="{Binding TraceStatus}" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.85" />
          <Button Grid.Column="1" Content="{Binding TraceLabel}" Command="{Binding TraceCommand}"
                  ToolTip.Tip="Has the game play the demo again (headless, with the mods) and write down where everyone went" />
        </Grid>
      </StackPanel>

      <!-- The level, with the replay, and the events beside it -->
      <Grid Grid.Row="1" ColumnDefinitions="*,250" ColumnSpacing="8">
        <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <Panel>
            <r:MapCanvas x:Name="Map" Tiles="{Binding Tiles}" Art="{Binding Art}" Overlay="{Binding Overlay}"
                         ShowThings="False" ShowGrid="False"
                         ToolTip.Tip="Drag to pan, wheel to zoom, Home to fit the level" />
            <TextBlock Text="The game doesn't have this demo's level" IsVisible="{Binding Tiles, Converter={x:Static ObjectConverters.IsNull}}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
          </Panel>
        </Border>
        <DockPanel Grid.Column="1">
          <TextBlock DockPanel.Dock="Top" Text="What happened" FontWeight="SemiBold" Margin="0,0,0,4" />
          <TextBlock DockPanel.Dock="Top" Text="The game hasn't played it yet" Opacity="0.6" FontSize="12" IsVisible="{Binding !HasTrace}" />
          <ListBox ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="6,2" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DemoEventItem">
                <Grid ColumnDefinitions="10,52,*" ColumnSpacing="4">
                  <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Grid>

      <!-- Playing it -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="6">
        <Button Content="⏮" Command="{Binding StepCommand}" CommandParameter="-1000000" ToolTip.Tip="To the start (Home)" />
        <Button Grid.Column="1" Content="◀" Command="{Binding StepCommand}" CommandParameter="-1" ToolTip.Tip="A frame back (Left; Shift for a second)" />
        <Button Grid.Column="2" Content="{Binding PlayLabel}" Command="{Binding PlayCommand}" Classes="accent" MinWidth="90" ToolTip.Tip="Space" />
        <Button Grid.Column="3" Content="▶" Command="{Binding StepCommand}" CommandParameter="1" ToolTip.Tip="A frame on (Right; Shift for a second)" />
        <Button Grid.Column="4" Content="⏭" Command="{Binding GoToEndCommand}" ToolTip.Tip="To the end (End)" />
        <ComboBox Grid.Column="5" ItemsSource="{Binding Speeds}" SelectedItem="{Binding Speed}" MinWidth="70" ToolTip.Tip="How fast it plays" />
        <CheckBox Grid.Column="6" Content="Follow the player" IsChecked="{Binding FollowPlayer}" VerticalAlignment="Center" Margin="6,0,0,0"
                  ToolTip.Tip="Scrolls the map to keep the player in sight" />
        <StackPanel Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="{Binding FrameText}" FontFamily="Consolas,Menlo,monospace" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>

      <!-- The controls along time -->
      <StackPanel Grid.Row="3" Spacing="4">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding PlayerText}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Opacity="0.85" />
          <TextBlock Grid.Column="1" Text="{Binding InputText}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Opacity="0.85" />
        </Grid>
        <r:DemoTimeline x:Name="Timeline" Demo="{Binding Demo}" Frame="{Binding Frame}" Events="{Binding Trace.Events, FallbackValue={x:Null}}"
                        Cursor="Hand" ToolTip.Tip="Click or drag to go to a moment" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
