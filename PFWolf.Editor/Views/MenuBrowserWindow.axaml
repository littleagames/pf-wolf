<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PFWolf.Editor.ViewModels"
        xmlns:data="using:PFWolf.Editor.Data"
        xmlns:v="using:PFWolf.Editor.Views"
        xmlns:sys="using:System"
        xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
        x:Class="PFWolf.Editor.Views.MenuBrowserWindow"
        x:DataType="vm:MenuBrowserViewModel"
        Title="{Binding Title}"
        Width="1500" Height="860" MinWidth="1060" MinHeight="600"
        WindowStartupLocation="CenterOwner">

  <DockPanel>
    <!-- What's listed -->
    <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBox x:Name="Search" Text="{Binding Filter}" VerticalAlignment="Center"
                 PlaceholderText="Find by name, file or mod (options, blake, my-mod)" />
        <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:MenuBrowserViewModel.ShowChoices}" SelectedIndex="{Binding ShowIndex}"
                  MinWidth="200" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding CountText}" VerticalAlignment="Center" Opacity="0.7" MinWidth="120" />
      </Grid>
    </Border>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.8" FontSize="12" Margin="8,0,8,6"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <!-- Every menu -->
    <ListBox x:Name="List" DockPanel.Dock="Left" Width="240" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="8,8,0,8">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="8,3" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:MenuListItem">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" ToolTip.Tip="{Binding ToolTip}" Opacity="{Binding Opacity}">
            <TextBlock Text="⚠" Foreground="OrangeRed" IsVisible="{Binding HasProblems}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Where}" Opacity="0.6" FontSize="11" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid ColumnDefinitions="Auto,*" Margin="8" ColumnSpacing="12" IsVisible="{Binding HasSelection}">
      <!-- The menu as the game draws it -->
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" MinWidth="660">
        <StackPanel Spacing="6">
          <SelectableTextBlock Text="{Binding SelectedItem.Name, FallbackValue=''}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Details}" TextWrapping="Wrap" Opacity="0.8" MaxWidth="780" HorizontalAlignment="Left" />
          <v:MenuPreviewView DataContext="{Binding Preview}" />
          <TextBlock Text="{Binding CodeNote}" TextWrapping="Wrap" FontSize="12" FontStyle="Italic" Opacity="0.75"
                     MaxWidth="780" HorizontalAlignment="Left" IsVisible="{Binding HasCodeNote}" />
        </StackPanel>
      </ScrollViewer>

      <!-- Where it comes from, what opens it, what's wrong, and the YAML it reads as -->
      <TabControl Grid.Column="1">
        <TabItem Header="Files and uses">
          <ScrollViewer>
            <StackPanel Spacing="6" Margin="0,8,0,0">
              <TextBlock Text="Made from (in order: a mod's is laid over the one before it)" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding Layers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="data:MenuLayer">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                      <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Edit…" Padding="8,2"
                              Command="{Binding $parent[Window].((vm:MenuBrowserViewModel)DataContext).EditLayerCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="In the Definitions window's YAML tab, which shows the menu again as you type (pfwolf.pk3's own: Copy to mod there)" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="Opened by" FontWeight="SemiBold" Margin="0,10,0,0" />
              <ItemsControl ItemsSource="{Binding Uses}" IsVisible="{Binding HasUses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="data:MenuUse">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Go to" Padding="8,2" IsVisible="{Binding Menu, Converter={x:Static ObjectConverters.IsNotNull}}"
                              Command="{Binding $parent[Window].((vm:MenuBrowserViewModel)DataContext).GoToUseCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Nothing names it: a mod's menu needs a CP_Menu item (menu: its name) to be opened." Opacity="0.6"
                         FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasUses}" />

              <TextBlock Text="Problems" FontWeight="SemiBold" Margin="0,10,0,0" />
              <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sys:String">
                    <TextBlock Text="{Binding}" Foreground="OrangeRed" TextWrapping="Wrap" FontSize="12" Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="None: it reads as the game reads it." Foreground="SeaGreen" FontSize="12" IsVisible="{Binding !HasProblems}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem x:Name="YamlTab" Header="YAML">
          <DockPanel Margin="0,8,0,0">
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12" Opacity="0.75" Margin="0,0,0,6"
                       Text="The menu as its files merge, to read: click a part of the picture to find it. Change it in its files (Edit… on the first tab)." />
            <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" CornerRadius="4">
              <avaloniaEdit:TextEditor x:Name="YamlBox" v:CodeEditorText.Text="{Binding MergedYaml, Mode=OneWay}" IsReadOnly="True"
                                       ShowLineNumbers="True" WordWrap="False" FontFamily="Consolas,Menlo,monospace" FontSize="13" Padding="4"
                                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </Border>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
