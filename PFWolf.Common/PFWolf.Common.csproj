<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the engine and the editor share: the asset types, the pk3 and data-file loaders,
       and the asset manager that merges them -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PFWolf</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- The editor's definitions window shows the asset types' doc comments beside their fields -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1570;CS1572;CS1573;CS1574;CS1584;CS1587;CS1591;CS1658;CS1711;CS1712;CS1734</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="NukedOPL3Sharp" Version="1.3.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PFWolf" />
    <InternalsVisibleTo Include="PFWolf.Tests" />
  </ItemGroup>

</Project>
