<Project Sdk="Microsoft.NET.Sdk">

  <!-- Writes schema.json: every definition file the game reads and every field in it, from the
       asset types and their doc comments (PFWolf.Common), and the engine's console commands as it
       registers them (PFWolf), for the documentation site -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PFWolf.DocGen</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PFWolf.Common\PFWolf.Common.csproj" />
    <ProjectReference Include="..\PFWolf\PFWolf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PFWolf.Tests" />
  </ItemGroup>

  <!-- The engine's version (PFWolf.csproj), so the schema says which release it describes -->
  <Target Name="EngineVersion" BeforeTargets="GetAssemblyAttributes">
    <XmlPeek XmlInputPath="..\PFWolf\PFWolf.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="EngineVersion" />
    </XmlPeek>
    <ItemGroup>
      <AssemblyMetadata Include="EngineVersion" Value="$(EngineVersion)" />
    </ItemGroup>
  </Target>

</Project>
