<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained Linux deploy: bundles the .NET runtime, SDL2 and OpenAL Soft, so players need
     nothing installed. x64 unless -r says otherwise:
     dotnet publish PFWolf -p:PublishProfile=linux [-r linux-arm64]
     packaging/linux/make-tarball.sh does this for the game and the editor and packs them up. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>bin\publish\$(RuntimeIdentifier)\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- SDL2 and OpenAL Soft stay beside the exe, where NativeSdl and NativeLibraries load them -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
