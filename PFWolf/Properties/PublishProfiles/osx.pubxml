<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained macOS deploy: bundles the .NET runtime, SDL2 and OpenAL Soft. Apple Silicon
     unless -r says otherwise:
     dotnet publish PFWolf -p:PublishProfile=osx [-r osx-x64]
     packaging/macos/make-apps.sh does this for the game and the editor and makes the .apps. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">osx-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishDir>bin\publish\$(RuntimeIdentifier)\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <!-- SDL2 and OpenAL Soft stay beside the exe (Contents/MacOS), where NativeSdl and NativeLibraries load them -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
