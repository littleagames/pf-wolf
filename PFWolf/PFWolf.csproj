<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
	<RootNamespace>PFWolf</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
	<PublishSelfContained>true</PublishSelfContained>
	<FileVersion>0.3.3.0</FileVersion>
	<AssemblyVersion>0.3.3.0</AssemblyVersion>
	<Version>0.3.3</Version>
	<Authors>Andrew McCauley</Authors>
	<Company>Little A Games</Company>
	<Copyright>Copyright (c) 2026 Little A Games</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="LiteNetLib" Version="2.1.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Mono.Nat" Version="3.0.4" />
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
	<ItemGroup>
		<PackageReference Include="OpenTK.Audio.OpenAL" Version="4.8.2" />
		<PackageReference Include="NukedOPL3Sharp" Version="1.2.1" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="ppy.SDL2-CS" Version="1.0.82" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="PFWolf.Tests" />
	</ItemGroup>
	<!-- OpenAL Soft 1.23.1 (OpenTK.Audio.OpenAL doesn't ship the native library) -->
	<!--<ItemGroup>
		<None Include="native\win-x64\OpenAL32.dll" Link="OpenAL32.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>-->
	<ItemGroup>
		<Content Include="..\pfwolf-pk3\**\*">
			<Link>pk3\%(RecursiveDir)%(FileName)%(Extension)</Link>
			<CopyToOutputDirectory>DoNotCopy</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<PropertyGroup>
		<PfWolfPk3SourceDir>$(MSBuildProjectDirectory)\..\pfwolf-pk3\</PfWolfPk3SourceDir>
	</PropertyGroup>
	<ItemGroup>
		<PfWolfPk3SourceFiles Include="$(PfWolfPk3SourceDir)**\*.*" />
	</ItemGroup>

	<Target Name="BuildPfWolfPk3" BeforeTargets="Build" Inputs="@(PfWolfPk3SourceFiles)" Outputs="$(TargetDir)pfwolf.pk3">
		<ZipDirectory SourceDirectory="$(PfWolfPk3SourceDir)" DestinationFile="$(TargetDir)pfwolf.pk3" Overwrite="true" />
		<ItemGroup>
			<FileWrites Include="$(TargetDir)pfwolf.pk3" />
		</ItemGroup>
	</Target>

	<!-- Where players put mods (pk3, zip or folder) for the Options menu's Mods screen -->
	<Target Name="CreateModsFolder" AfterTargets="Build">
		<MakeDir Directories="$(TargetDir)mods" />
	</Target>

	<!-- The example mods (examples/mods), ready to switch on in the Mods screen -->
	<ItemGroup>
		<ExampleModFiles Include="$(MSBuildProjectDirectory)\..\examples\mods\**\*.*" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Remove="Models\**" />
	  <EmbeddedResource Remove="Models\**" />
	  <None Remove="Models\**" />
	</ItemGroup>
	<Target Name="CopyExampleMods" AfterTargets="CreateModsFolder">
		<Copy SourceFiles="@(ExampleModFiles)" DestinationFiles="@(ExampleModFiles->'$(TargetDir)mods\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>

	<!-- multiplayer.pk3 (multiplayer-pk3): a mod, off until switched on in the Mods screen -->
	<PropertyGroup>
		<MultiplayerPk3SourceDir>$(MSBuildProjectDirectory)\..\multiplayer-pk3\</MultiplayerPk3SourceDir>
	</PropertyGroup>
	<ItemGroup>
		<MultiplayerPk3SourceFiles Include="$(MultiplayerPk3SourceDir)**\*.*" />
	</ItemGroup>
	<Target Name="BuildMultiplayerPk3" AfterTargets="CreateModsFolder" Inputs="@(MultiplayerPk3SourceFiles)" Outputs="$(TargetDir)mods\multiplayer.pk3">
		<ZipDirectory SourceDirectory="$(MultiplayerPk3SourceDir)" DestinationFile="$(TargetDir)mods\multiplayer.pk3" Overwrite="true" />
		<ItemGroup>
			<FileWrites Include="$(TargetDir)mods\multiplayer.pk3" />
		</ItemGroup>
	</Target>

	<!-- Publish carries the pk3s and example mods too (they're made in the build folder, not as content) -->
	<Target Name="PublishPfWolfExtras" AfterTargets="ComputeResolvedFilesToPublishList">
		<ItemGroup>
			<ResolvedFileToPublish Include="$(TargetDir)pfwolf.pk3" RelativePath="pfwolf.pk3" CopyToPublishDirectory="PreserveNewest" />
			<ResolvedFileToPublish Include="$(TargetDir)mods\multiplayer.pk3" RelativePath="mods\multiplayer.pk3" CopyToPublishDirectory="PreserveNewest" />
			<ResolvedFileToPublish Include="@(ExampleModFiles)" RelativePath="mods\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>
</Project>
